{
  "preset": "typescript",
  "layout": {
    "sourceRoots": ["core", "languages"],
    "entryPoints": [
      "core/diff/cache/http-cache-worker.mjs",
      "core/fix/prettier-base-runner.mjs",
      "languages/python/adapters/python-runner.mjs",
      "core/fix/prettier-write-runner.mjs",
      "languages/typescript/adapters/entry-points-runner.mjs",
      "languages/typescript/adapters/eslint-wrapper.config.mjs",
      "languages/typescript/preset/*/report.mjs",
      "languages/typescript/preset/defaults/crap.config.mjs",
      "languages/typescript/preset/defaults/stryker.config.mjs",
      "languages/typescript/preset/eslint-config/policies/coding-standards.config.mjs",
      "languages/typescript/preset/eslint-config/policies/errors.config.mjs",
      "languages/typescript/preset/eslint-config/policies/module-effects.config.mjs",
      "core/cli.mjs",
      "core/diff/sharding/aggregate-shards.mjs",
      "core/diff/execution/analyzer-scheduler.mjs",
      "languages/java/adapters/java-runner.mjs",
      "languages/typescript/adapters/eslint-runner.mjs",
      "languages/typescript/adapters/quality-areas-runner.mjs",
      "languages/typescript/adapters/static-checks-runner.mjs",
      "languages/typescript/preset/architecture/public-contract-usage.mjs",
      "languages/typescript/preset/architecture/runtime-dependency-boundaries.mjs",
      "languages/typescript/preset/coding-standards/check.mjs"
    ]
  },
  "exclude": [
    "languages/java/ingest/fixtures/**",
    "languages/java/adapters/fixtures/**",
    "languages/javascript/preset/fixtures/**",
    "languages/python/ingest/fixtures/**",
    "languages/python/rules/fixtures/**",
    "languages/python/adapters/fixtures/**",
    "core/diff/fixtures/**",
    "languages/typescript/preset/fixtures/**",
    "languages/typescript/preset/architecture/fixtures/**",
    "languages/typescript/preset/coupling/fixtures/**",
    "languages/typescript/preset/crap/fixtures/**",
    "languages/typescript/preset/dependency-graph/fixtures/**",
    "languages/typescript/preset/duplicates/fixtures/**",
    "languages/typescript/preset/entry-points/fixtures/**",
    "languages/typescript/preset/structure/fixtures/**",
    "languages/typescript/preset/test-runtime/fixtures/**"
  ],
  "disable": ["typescript-typecheck", "coverage", "crap", "mutation"],
  "exceptions": [
    {
      "rule": "nitpicker/no-node-process-per-test",
      "paths": ["languages/typescript/preset/duplicates/duplicates-policy.test.mjs"],
      "reason": "jscpd ships only as a native executable behind a launcher script with no importable API, and the file checks its exit status and report for a missing config, so the process boundary is the thing under test."
    },
    {
      "rule": "nitpicker/no-raised-test-timeout",
      "paths": [
        "languages/java/adapters/java-preset.e2e.test.mjs",
        "languages/java/adapters/spring/java-spring.e2e.test.mjs"
      ],
      "reason": "Opt-in end-to-end suite that runs Gradle builds (minutes per step); it cannot be made faster and is skipped unless NITPICKER_JAVA_E2E=1."
    },
    {
      "rule": "@typescript-eslint/no-unsafe-member-access",
      "paths": ["**/*.mjs"],
      "reason": "Type-aware rule: plain .mjs has no type information, so every imported value is any and the rule only reports noise."
    },
    {
      "rule": "@typescript-eslint/no-unsafe-assignment",
      "paths": ["**/*.mjs"],
      "reason": "Type-aware rule: plain .mjs has no type information, so every imported value is any and the rule only reports noise."
    },
    {
      "rule": "@typescript-eslint/no-unsafe-call",
      "paths": ["**/*.mjs"],
      "reason": "Type-aware rule: plain .mjs has no type information, so every imported value is any and the rule only reports noise."
    },
    {
      "rule": "@typescript-eslint/no-unsafe-argument",
      "paths": ["**/*.mjs"],
      "reason": "Type-aware rule: plain .mjs has no type information, so every imported value is any and the rule only reports noise."
    },
    {
      "rule": "@typescript-eslint/no-unsafe-return",
      "paths": ["**/*.mjs"],
      "reason": "Type-aware rule: plain .mjs has no type information, so every imported value is any and the rule only reports noise."
    },
    {
      "rule": "@typescript-eslint/restrict-template-expressions",
      "paths": ["**/*.mjs"],
      "reason": "Type-aware rule: plain .mjs has no type information, so every imported value is any and the rule only reports noise."
    },
    {
      "rule": "@typescript-eslint/restrict-plus-operands",
      "paths": ["**/*.mjs"],
      "reason": "Type-aware rule: plain .mjs has no type information, so every imported value is any and the rule only reports noise."
    }
  ]
}
