SAMPLE=languages/javascript/preset/fixtures/js-clean
dev() { node -p "require('$repo/package.json').devDependencies['$1']"; }
SETUP="npm install --no-audit --no-fund vitest@$(dev vitest) @vitest/coverage-v8@$(dev @vitest/coverage-v8) typescript@$(dev typescript) @types/node@$(dev @types/node)"
VIOLATION_RULE='^eslint-lint/no-var$'
