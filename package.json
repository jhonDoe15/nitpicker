{
  "name": "nitpicker",
  "version": "0.1.0-rc.1",
  "description": "A quality gate for code written by coding agents. It narrows each language to one allowed way of doing each thing and fails a change only for the problems it adds.",
  "keywords": [
    "quality-gate",
    "code-quality",
    "lint",
    "coding-agents",
    "typescript",
    "javascript",
    "react",
    "python",
    "java",
    "kotlin",
    "mutation-testing",
    "eslint"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhonDoe15/nitpicker.git"
  },
  "homepage": "https://github.com/jhonDoe15/nitpicker#readme",
  "bugs": {
    "url": "https://github.com/jhonDoe15/nitpicker/issues"
  },
  "bin": {
    "nitpicker": "core/cli.mjs"
  },
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.mts",
    "gen:checks": "node scripts/gen-checks.mjs",
    "test:installed": "NITPICKER_INSTALLED_TEST=1 vitest run --config vitest.config.mts core/installed.test.mjs",
    "test:record-eslint": "node core/diff/fixtures/record-eslint-reports.mjs",
    "test:conformance": "vitest run --config vitest.config.mts core/diff/conformance.test.mjs",
    "test:java": "NITPICKER_JAVA_E2E=1 vitest run --config vitest.config.mts --no-file-parallelism languages/java/adapters/java-preset.e2e.test.mjs languages/java/adapters/spring/java-spring.e2e.test.mjs languages/java/adapters/suppressions/escape-hatches.e2e.test.mjs",
    "test:python": "NITPICKER_PYTHON_E2E=1 vitest run --config vitest.config.mts --testTimeout=900000 --hookTimeout=900000 languages/python/adapters/python-preset.e2e.test.mjs languages/python/rules/nitpicker-rules.e2e.test.mjs languages/python/rules/rule-cases.e2e.test.mjs",
    "test:kotlin": "NITPICKER_KOTLIN_E2E=1 vitest run --config vitest.config.mts --testTimeout=900000 --hookTimeout=900000 languages/java/adapters/kotlin-metrics.e2e.test.mjs languages/java/adapters/kotlin-preset.e2e.test.mjs"
  },
  "prettier": "./languages/typescript/preset/defaults/.prettierrc.json",
  "files": [
    "core/**/*.mjs",
    "shared/**/*.mjs",
    "languages/**",
    "!**/*.test.mjs",
    "!**/fixtures/**",
    "!**/README.md",
    "skills/**"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@types/node": ">=20",
    "@vitest/coverage-v8": "^4.1.11 || ^5.0.0",
    "typescript": ">=5.7",
    "vitest": "^4.1.11 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    },
    "@vitest/coverage-v8": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@barney-media/crap-typescript-core": "0.5.3",
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@vitest/eslint-plugin": "1.6.27",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.1",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-x": "5.21.0",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.11.0",
    "jscpd": "5.0.16",
    "knip": "6.32.3",
    "prettier": "3.9.6",
    "smol-toml": "1.9.0",
    "typescript-eslint": "8.68.0"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/react": "19.2.2",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  }
}
