import { typescriptRuleTester } from '../../../test-support/rule-tester.mts';
import { rule } from './no-overlapping-ts-program.mts';

const tester = typescriptRuleTester();

function flagged(code: string, messageId: 'overlappingProgram' | 'overlappingChecker') {
  return { code, errors: [{ messageId }] };
}

tester.run('no-overlapping-ts-program', rule, {
  valid: [
    [
      'import * as ts from "typescript";',
      'function analyze(roots: string[], otherRoots: string[], options: ts.CompilerOptions) {',
      '  const first = ts.createProgram(roots, options);',
      '  const files = first.getSourceFiles().length;',
      '  const second = ts.createProgram(otherRoots, options);',
      '  return { files, secondFiles: second.getSourceFiles().length };',
      '}',
    ].join('\n'),
    [
      'import * as ts from "typescript";',
      'function analyze(roots: string[], otherRoots: string[], options: ts.CompilerOptions) {',
      '  const first = ts.createProgram(roots, options);',
      '  const checker = first.getTypeChecker();',
      '  const symbols = checker.getAmbientModules().length;',
      '  const second = ts.createProgram(otherRoots, options);',
      '  return { symbols, secondFiles: second.getSourceFiles().length };',
      '}',
    ].join('\n'),
    [
      'import * as ts from "typescript";',
      'function firstPass(roots: string[], options: ts.CompilerOptions) {',
      '  const program = ts.createProgram(roots, options);',
      '  return program.getSourceFiles().length;',
      '}',
      'function secondPass(otherRoots: string[], options: ts.CompilerOptions) {',
      '  const program = ts.createProgram(otherRoots, options);',
      '  return program.getSourceFiles().length;',
      '}',
    ].join('\n'),
    [
      'import * as ts from "typescript";',
      'function outer(roots: string[], otherRoots: string[], options: ts.CompilerOptions) {',
      '  const first = ts.createProgram(roots, options);',
      '  function inner() {',
      '    return ts.createProgram(otherRoots, options);',
      '  }',
      '  return { files: first.getSourceFiles().length, inner };',
      '}',
    ].join('\n'),
    [
      'import * as ts from "typescript";',
      'function pick(fast: boolean, a: string[], b: string[], options: ts.CompilerOptions) {',
      '  let program: ts.Program;',
      '  if (fast) {',
      '    program = ts.createProgram(a, options);',
      '  } else {',
      '    program = ts.createProgram(b, options);',
      '  }',
      '  return program.getSourceFiles().length;',
      '}',
    ].join('\n'),
    [
      'import * as ts from "typescript";',
      'function pick(fast: boolean, a: string[], b: string[], options: ts.CompilerOptions) {',
      '  let program: ts.Program | undefined;',
      '  if (fast) {',
      '    program = ts.createProgram(a, options);',
      '    return program.getSourceFiles().length;',
      '  }',
      '  const second = ts.createProgram(b, options);',
      '  return program ? 0 : second.getSourceFiles().length;',
      '}',
    ].join('\n'),
    [
      'import * as ts from "typescript";',
      'function pick(fast: boolean, a: string[], b: string[], options: ts.CompilerOptions) {',
      '  const program = fast ? ts.createProgram(a, options) : ts.createProgram(b, options);',
      '  return program.getSourceFiles().length;',
      '}',
    ].join('\n'),
    [
      'import * as ts from "typescript";',
      'function pick(mode: string, a: string[], b: string[], options: ts.CompilerOptions) {',
      '  let program: ts.Program;',
      '  switch (mode) {',
      '    case "a":',
      '      program = ts.createProgram(a, options);',
      '      break;',
      '    default:',
