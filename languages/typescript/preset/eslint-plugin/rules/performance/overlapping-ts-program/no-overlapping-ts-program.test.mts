      '}',
    ].join('\n'),
    [
      'import * as ts from "typescript";',
      'function cleared(a: string[], b: string[], options: ts.CompilerOptions) {',
      '  let program: ts.Program | undefined = ts.createProgram(a, options);',
      '  const countA = program.getSourceFiles().length;',
