function promise(type: string) {
  return `Promise<${type}>`;
}

const TYPEORM = [
  'export declare class FindOperator<T> { constructor(value: T); readonly value: T; }',
  'export type FindOptionsWhere<T> = { [P in keyof T]?: T[P] | FindOperator<T[P]> };',
  'export type FindManyOptions<T> = {',
  '  where?: FindOptionsWhere<T> | FindOptionsWhere<T>[];',
  '  select?: (keyof T & string)[] | { [P in keyof T]?: boolean };',
  '  relations?: string[] | Record<string, boolean>;',
  '  order?: { [P in keyof T]?: "ASC" | "DESC" };',
  '  withDeleted?: boolean;',
  '  loadEagerRelations?: boolean;',
  '  take?: number;',
  '  skip?: number;',
  '  lock?: { mode: string };',
  '  cache?: boolean;',
  '};',
  'type Criteria<T> = string | number | FindOptionsWhere<T>;',
  'export declare class DeleteResult { affected?: number }',
  'export declare class UpdateResult { affected?: number }',
  'export declare class InsertResult { identifiers: object[] }',
  'export declare class Repository<T extends object> {',
  `  find(options?: FindManyOptions<T>): ${promise('T[]')};`,
  `  findBy(where: FindOptionsWhere<T> | FindOptionsWhere<T>[]): ${promise('T[]')};`,
  `  findOne(options: FindManyOptions<T>): ${promise('T | null')};`,
  `  findOneBy(where: FindOptionsWhere<T> | FindOptionsWhere<T>[]): ${promise('T | null')};`,
  `  findOneOrFail(options: FindManyOptions<T>): ${promise('T')};`,
  `  delete(criteria: Criteria<T>): ${promise('DeleteResult')};`,
  `  update(criteria: Criteria<T>, data: Partial<T>): ${promise('UpdateResult')};`,
  `  insert(entity: Partial<T> | Partial<T>[]): ${promise('InsertResult')};`,
  `  save<E extends Partial<T>>(entity: E): ${promise('E')};`,
  `  remove(entity: T): ${promise('T')};`,
  '  create(entity?: Partial<T>): T;',
  '}',
  'export declare class EntityManager {',
  `  find<T extends object>(target: new () => T, options?: FindManyOptions<T>): ${promise('T[]')};`,
  '}',
  'export declare function In<T>(values: readonly T[]): FindOperator<T>;',
  'export declare function Not<T>(value: T): FindOperator<T>;',
  'export declare function Entity(name?: string): ClassDecorator;',
  'export declare function Unique(...columns: unknown[]): ClassDecorator;',
  'export declare function VersionColumn(): PropertyDecorator;',
  'export declare function UpdateDateColumn(): PropertyDecorator;',
  'export declare function BeforeUpdate(): MethodDecorator;',
  'export declare function AfterRemove(): MethodDecorator;',
  'export declare function AfterLoad(): MethodDecorator;',
  'export declare function PrimaryGeneratedColumn(strategy?: string | object, options?: object): PropertyDecorator;',
  'export declare function PrimaryColumn(typeOrOptions?: string | object, options?: object): PropertyDecorator;',
  'export declare function Column(typeOrOptions?: string | object, options?: object): PropertyDecorator;',
  'export declare function ManyToOne(type: () => Function): PropertyDecorator;',
  'export declare function OneToMany(type: () => Function, inverse: (value: any) => unknown): PropertyDecorator;',
].join('\n');

const MODELS: Record<string, string> = {
  User: '{ id: number; email: string; name: string; teamId: number }',
  Team: '{ id: string; name: string }',
  Doc: '{ id: string; title: string }',
  Tag: '{ id: number; name: string; userId: number }',
};

function delegate(name: string, row: string) {
  return [
    `export interface ${name}Delegate {`,
    `  findUnique(args: object): ${promise(`${row} | null`)};`,
    `  findFirst(args?: object): ${promise(`${row} | null`)};`,
    `  findUniqueOrThrow(args: object): ${promise(row)};`,
    `  findMany(args?: object): ${promise(`${row}[]`)};`,
    `  create(args: object): ${promise(row)};`,
    `  createMany(args: object): ${promise('{ count: number }')};`,
    `  delete(args: object): ${promise(row)};`,
    `  deleteMany(args?: object): ${promise('{ count: number }')};`,
    `  update(args: object): ${promise(row)};`,
    `  updateMany(args: object): ${promise('{ count: number }')};`,
    '}',
  ].join('\n');
}

const PRISMA_CLIENT = [
  ...Object.entries(MODELS).map(([name, row]) => delegate(name, row)),
  'export declare class PrismaClient {',
  '  user: UserDelegate;',
  '  team: TeamDelegate;',
  '  doc: DocDelegate;',
  '  tag: TagDelegate;',
  `  $transaction<T>(work: (tx: Omit<PrismaClient, '$transaction'>) => ${promise('T')}): ${promise('T')};`,
  '}',
].join('\n');

export function prismaSchema(provider: string): string {
  return [
    `datasource db {\n  provider = "${provider}"\n  url = env("DATABASE_URL")\n}`,
    'model User {',
    '  id Int @id @default(autoincrement())',
    '  email String @unique // the login',
    '  name String',
    '  teamId Int',
    '  team Team @relation(fields: [teamId], references: [id])',
    '}',
    'model Team {',
    '  id String @id',
    '  name String',
    '  users User[]',
    '}',
    'model Doc {',
    '  id String @id @db.Uuid',
    '  title String',
    '}',
    'model Tag {',
    '  id Int @id',
    '  name String',
    '  userId Int',
    '}',
  ].join('\n');
}

const REDIS_COMMANDS = [
  'interface RedisCommander {',
  `  get(key: string): ${promise('string | null')};`,
  `  mget(keys: string[]): ${promise('(string | null)[]')};`,
  `  set(key: string, value: string, mode?: string, seconds?: number): ${promise("'OK'")};`,
  '}',
  'export interface ChainableCommander {',
  '  get(key: string): this;',
  `  exec(): ${promise('unknown[]')};`,
  '}',
  'export declare class Redis implements RedisCommander {',
  `  get(key: string): ${promise('string | null')};`,
  `  mget(keys: string[]): ${promise('(string | null)[]')};`,
  `  set(key: string, value: string, mode?: string, seconds?: number): ${promise("'OK'")};`,
  '  pipeline(): ChainableCommander;',
  '  multi(): ChainableCommander;',
  '}',
  'export declare class Cluster implements RedisCommander {',
  `  get(key: string): ${promise('string | null')};`,
  `  mget(keys: string[]): ${promise('(string | null)[]')};`,
  `  set(key: string, value: string, mode?: string, seconds?: number): ${promise("'OK'")};`,
  '}',
  'export default Redis;',
].join('\n');

const CLIENT_COMMANDS = [
  'export interface ClientCommands {',
  `  get(key: string): ${promise('string | null')};`,
  `  mGet(keys: string[]): ${promise('(string | null)[]')};`,
  '}',
].join('\n');

const CLUSTER_COMMANDS = CLIENT_COMMANDS.replace('ClientCommands', 'ClusterCommands');

export const ORM_PACKAGE_FILES: Readonly<Record<string, string>> = {
  'typeorm/index.d.ts': TYPEORM,
  '.prisma/client/index.d.ts': PRISMA_CLIENT,
  '@prisma/client/index.d.ts': "export * from '.prisma/client';",
  'ioredis/index.d.ts': REDIS_COMMANDS,
  '@redis/client/dist/lib/client/commands.d.ts': CLIENT_COMMANDS,
  '@redis/client/dist/lib/cluster/commands.d.ts': CLUSTER_COMMANDS,
  '@redis/client/index.d.ts': [
    "import type { ClientCommands } from './dist/lib/client/commands';",
    "import type { ClusterCommands } from './dist/lib/cluster/commands';",
    `export type RedisClientType = ClientCommands & { quit(): ${promise('void')} };`,
    `export type RedisClusterType = ClusterCommands & { quit(): ${promise('void')} };`,
    'export declare function createClient(): RedisClientType;',
    'export declare function createCluster(): RedisClusterType;',
  ].join('\n'),
  'redis/index.d.ts': "export * from '@redis/client';",
};

