{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.ts",
    "src/server.ts",
    "src/main/main.ts",
    "src/main/server.ts",
    "src/main/composition-root.{ts,tsx,mts,js,jsx,mjs}",
    "src/main/composition-root/index.{ts,tsx,mts,js,jsx,mjs}",
    "vitest.config.ts",
    "src/main/vitest.config.ts",
    "test/vitest.config.ts",
    "tests/vitest.config.ts",
    "__tests__/vitest.config.ts",
    "e2e/vitest.config.ts",
    "vitest.quality.config.ts",
    "jest.config.{ts,mts}",
    "src/main/jest.config.{ts,mts}",
    "test/jest.config.{ts,mts}",
    "tests/jest.config.{ts,mts}",
    "__tests__/jest.config.{ts,mts}",
    "e2e/jest.config.{ts,mts}",
    ".mocharc.{js,cjs,mjs}",
    "test/fixtures/*harness*.{ts,mts,mjs}",
    "tests/fixtures/*harness*.{ts,mts,mjs}",
    "__tests__/fixtures/*harness*.{ts,mts,mjs}",
    "e2e/fixtures/*harness*.{ts,mts,mjs}"
  ],
  "project": [
    "src/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
    "test/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
    "tests/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
    "__tests__/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
    "e2e/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
    "*.config.{ts,mts,mjs}"
  ],
  "ignore": ["src/**/*.d.ts", "coverage/**", "reports/**", ".stryker-tmp/**", ".nitpicker-*"]
}
