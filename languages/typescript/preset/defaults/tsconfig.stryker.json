{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2024"],
    "esModuleInterop": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*", "test/**/*", "tests/**/*", "__tests__/**/*", "stryker.vitest.config.ts"],
  "exclude": [
    "dist/**",
    "build/**",
    "generated/**",
    "**/node_modules/**",
    "coverage/**",
    "reports/quality/**",
    "target/**"
  ]
}
