{
  "path": ["src", "test", "tests", "__tests__", "e2e"],
  "format": ["typescript", "tsx"],
  "mode": "mild",
  "reporters": ["console", "json"],
  "output": "reports/quality/duplicates",
  "ignore": [
    "dist/**",
    "build/**",
    "generated/**",
    "coverage/**",
    "reports/**",
    "target/**",
    "**/node_modules/**",
    "**/*.d.ts",
    "**/.stryker-tmp/**"
  ]
}
