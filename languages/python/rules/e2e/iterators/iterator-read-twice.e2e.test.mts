import { describe } from 'vitest';
import { useRuleScripts, pythonLines as code } from '../../test-support/python-rule-scripts.mts';

const enabled = process.env['NITPICKER_PYTHON_E2E'] === '1';
const { itOutcomes } = useRuleScripts('iterator-read-twice', { enabled });

describe.skipIf(!enabled)('iterator-read-twice', () => {
  itOutcomes('reports a one-shot iterator read by two consuming operations', [
    [
      'two aggregations of a generator expression',
      code(
        'def total(values):',
        '    items = (x * 2 for x in values)',
        '    first = list(items)',
        '    second = sum(items)',
        '    return first, second',
      ),
      ['iterator-read-twice:4 items (total)'],
    ],
    [
      'a membership test before a loop',
      code(
        'def find(values):',
        '    seen = map(str, values)',
        '    if "a" in seen:',
        '        return 1',
        '    return list(seen)',
      ),
      ['iterator-read-twice:5 seen (find)'],
    ],
    [
      'a call to a generator function of the project',
      code(
        'def numbers():',
        '    yield 1',
        '',
        '',
        'def use():',
        '    items = numbers()',
        '    a = [i for i in items]',
        '    b = len(items)',
        '    return a, b',
      ),
      ['iterator-read-twice:8 items (use)'],
    ],
    [
      'itertools, zip, filter, iter and reversed results',
      code(
        'import itertools',
        '',
        '',
        'def use(values):',
        '    a = itertools.chain(values, values)',
        '    list(a)',
        '    max(a)',
        '    b = zip(values, values)',
        '    dict(b)',
        '    set(b)',
        '    c = filter(None, values)',
        '    sorted(c)',
        '    any(c)',
        '    d = reversed(values)',
        '    tuple(d)',
        '    all(d)',
        '    e = iter(values)',
        '    ",".join(e)',
        '    list(e)',
      ),
      [
        'iterator-read-twice:7 a (use)',
        'iterator-read-twice:10 b (use)',
        'iterator-read-twice:13 c (use)',
        'iterator-read-twice:16 d (use)',
        'iterator-read-twice:19 e (use)',
      ],
    ],
    [
      'a membership test inside a loop or comprehension over other values',
      code(
        'def use(values, others):',
        '    seen = (v for v in values)',
        '    hits = [o for o in others if o in seen]',
        '    for other in others:',
        '        if other in seen:',
        '            print(other)',
        '    return hits',
      ),
      ['iterator-read-twice:5 seen (use)'],
    ],
    [
      'a generator handed to a project function that iterates it',
      code(
        'def consume(xs):',
        '    for x in xs:',
        '        print(x)',
        '',
        '',
        'def use(values):',
        '    it = (v for v in values)',
        '    consume(it)',
        '    return list(it)',
      ),
      ['iterator-read-twice:9 it (use)'],
    ],
    [
      'unpacking and a star argument',
      code(
        'def use(values):',
        '    it = (v for v in values)',
        '    a, b = it',
        '    return print(*it)',
      ),
      ['iterator-read-twice:4 it (use)'],
    ],
    [
      'an attribute set from a generator and read twice',
      code(
        'class Walker:',
        '    def start(self, values):',
        '        self.items = (v for v in values)',
        '        first = list(self.items)',
        '        return first, len(self.items)',
      ),
      ['iterator-read-twice:5 self.items (Walker.start)'],
    ],
  ]);

  itOutcomes('reports a parameter that is read and then forwarded or read again', [
    [
      'an Iterable parameter tested and then passed on',
      code(
        'from collections.abc import Iterable',
        '',
        '',
        'def check(items: Iterable[int]):',
        '    if 5 in items:',
        '        print(1)',
        '    return helper(items)',
      ),
      ['iterator-read-twice:7 items (check)'],
    ],
    [
      'an Iterator parameter iterated twice and an optional one',
      code(
        'from typing import Iterator, Optional',
        '',
        '',
        'def twice(items: Iterator[int], extra: Optional[Iterator[int]]):',
        '    first = list(items)',
        '    for x in items:',
        '        print(x)',
        '    return first, sum(extra), len(extra)',
      ),
      ['iterator-read-twice:6 items (twice)', 'iterator-read-twice:8 extra (twice)'],
    ],
    [
      'update_fields iterated and then forwarded through kwargs',
      code(
        'class Thing:',
        '    def save(self, *args, **kwargs):',
        '        update_fields = kwargs.get("update_fields")',
        '        names = [name for name in update_fields]',
        '        super().save(*args, **kwargs)',
      ),
      ['iterator-read-twice:5 update_fields (Thing.save)'],
    ],
    [
      'update_fields as a parameter iterated and then forwarded by keyword',
      code(
        'class Thing:',
        '    def save(self, update_fields=None, **kwargs):',
        '        for field in update_fields:',
        '            print(field)',
        '        super().save(update_fields=update_fields, **kwargs)',
      ),
      ['iterator-read-twice:5 update_fields (Thing.save)'],
    ],
  ]);

  itOutcomes('leaves a single read, materialized values and exclusive reads alone', [
    [
      'one read, a list and a name materialized in place',
      code(
        'def use(values):',
        '    once = zip(values, values)',
        '    a = list(once)',
        '    items = (v for v in values)',
        '    items = list(items)',
        '    b = len(items) + sum(items)',
        '    seq = [v for v in values]',
        '    return a, b, len(seq), sum(seq)',
      ),
      [],
    ],
    [
      'reads in the two arms of an if and in a branch that returns',
      code(
        'def use(values, flag):',
        '    a = filter(None, values)',
        '    if flag:',
        '        return list(a)',
        '    else:',
        '        return tuple(a)',
        '',
        '',
        'def early(values, flag):',
        '    b = iter(values)',
        '    if flag:',
        '        return list(b)',
        '    return tuple(b)',
      ),
      [],
    ],
    [
      'itertools.tee, truthiness and identity checks',
      code(
        'import itertools',
        '',
        '',
        'def use(values):',
        '    left, right = itertools.tee(values)',
        '    first = list(left)',
        '    second = list(right)',
        '    gen = (v for v in values)',
        '    if gen is None or not gen:',
        '        return first',
        '    return first, second, list(gen)',
      ),
      [],
    ],
    [
      'a parameter materialized first and a Collection parameter',
      code(
        'from collections.abc import Collection, Iterable',
        '',
        '',
        'def use(items: Iterable[int], other: Collection[int]):',
        '    items = list(items)',
        '    if 5 in items:',
        '        print(len(items))',
        '    return helper(items), 5 in other, sum(other)',
      ),
      [],
    ],
    [
      'update_fields made a list before the first test',
      code(
        'class Thing:',
        '    def save(self, *args, **kwargs):',
        '        update_fields = kwargs.get("update_fields")',
        '        if update_fields is not None:',
        '            update_fields = kwargs["update_fields"] = list(update_fields)',
        '        if update_fields and "status" in update_fields:',
        '            print(1)',
        '        super().save(*args, **kwargs)',
      ),
      [],
    ],
    [
      'update_fields in a method that is not save, and a single read in save',
      code(
        'class Thing:',
        '    def refresh(self, *args, **kwargs):',
        '        update_fields = kwargs.get("update_fields")',
        '        if update_fields and "status" in update_fields:',
        '            print(1)',
        '        super().refresh(*args, **kwargs)',
        '',
        '    def save(self, *args, **kwargs):',
        '        update_fields = kwargs.get("update_fields")',
        '        return update_fields is None',
      ),
      [],
    ],
    [
      'update_fields only tested and forwarded by name or through kwargs',
      code(
        'class Thing:',
        '    def save(self, *args, update_fields=None, **kwargs):',
        '        if update_fields is None or "status" in update_fields:',
        '            print(1)',
        '        super().save(*args, update_fields=update_fields, **kwargs)',
        '',
        '    def asave(self, *args, **kwargs):',
        '        update_fields = kwargs.get("update_fields")',
        '        if update_fields and "status" in update_fields:',
        '            print(1)',
        '        super().asave(*args, **kwargs)',
      ),
      [],
    ],
    [
      'the same iterator repeated in zip, and an iter continued after a break',
      code(
        'def pairs(values):',
        '    it = iter(values)',
        '    return list(zip(it, it))',
        '',
        '',
        'def split(values):',
        '    it = iter(values)',
        '    head = []',
        '    for item in it:',
        '        head.append(item)',
        '        if item == 0:',
        '            break',
        '    for item in it:',
        '        print(item)',
        '    return head',
      ),
      [],
    ],
    [
      'a test file',
      {
        files: {
          'tests/test_mod.py': code(
            'def test_it(values):',
            '    items = (v for v in values)',
            '    assert list(items) == sum(items)',
          ),
        },
      },
      [],
    ],
  ]);
});
