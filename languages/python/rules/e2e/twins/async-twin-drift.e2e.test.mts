import { describe } from 'vitest';
import { useScripts, pythonLines as code } from '../../test-support/python-rule-scripts.mts';

const enabled = process.env['NITPICKER_PYTHON_E2E'] === '1';
const { itOutcomes } = useScripts({
  enabled,
  hidden: ['swallowed-exception', 'unused-option', 'unclosed-inline-resource'],
});

const RULE = 'async-twin-drift';

describe.skipIf(!enabled)('async-twin-drift', () => {
  itOutcomes('flags a difference between a sync function and its async twin', [
    [
      'a guard that only the sync twin has',
      code(
        'def batch_iterate(size, items):',
        '    if size is None or size <= 0:',
        '        return [list(items)]',
        '    return chunk(items, size)',
        '',
        '',
        'async def abatch_iterate(size, items):',
        '    return chunk(items, size)',
      ),
      [`${RULE}:7 abatch_iterate|batch_iterate|guard|size is None or size <= 0|sync`],
    ],
    [
      'a parameter that only the async twin lacks',
      code(
        'class Tool:',
        '    def run(self, query, tags=None):',
        '        return self.search(query, tags)',
        '',
        '    async def arun(self, query):',
        '        return await self.asearch(query)',
        '',
        '    def search(self, query, tags=None):',
        '        return [query]',
        '',
        '    async def asearch(self, query):',
        '        return [query]',
      ),
      [`${RULE}:5 Tool.arun|Tool.run|parameter|tags|sync`],
    ],
    [
      'an exception type caught on one side only',
      code(
        'def call(tool, data):',
        '    try:',
        '        return tool.run(data)',
        '    except (ValidationError, TypeError):',
        '        return None',
        '',
        '',
        'async def acall(tool, data):',
        '    try:',
        '        return await tool.arun(data)',
        '    except ValidationError:',
        '        return None',
      ),
      [`${RULE}:8 acall|call|exception|TypeError|sync`],
    ],
    [
      'a call that only the async twin makes',
      code(
        'def rank_fusion(docs):',
        '    docs = normalize(docs)',
        '    return merge(docs)',
        '',
        '',
        'async def arank_fusion(docs):',
        '    return merge(docs)',
      ),
      [`${RULE}:6 arank_fusion|rank_fusion|call|normalize|sync`],
    ],
    [
      'a once-only guard that only the sync stream has, with the _async suffix',
      code(
        'def stream(items):',
        '    if not items:',
        '        return',
        '    yield emit(items)',
        '',
        '',
        'async def stream_async(items):',
        '    yield emit(items)',
      ),
      [`${RULE}:7 stream_async|stream|guard|not items|sync`],
    ],
    [
      'a private twin pair with an extra async call',
      code(
        'class Model:',
        '    def _stream(self, prompt):',
        '        yield self.send(prompt)',
        '',
        '    async def _astream(self, prompt):',
        '        yield await self.asend(prompt)',
        '        self.trace(prompt)',
      ),
      [`${RULE}:5 Model._astream|Model._stream|call|trace|async`],
    ],
  ]);

  itOutcomes('stays quiet when the twins agree or delegate', [
    [
      'twins with the same guard, parameters and calls',
      code(
        'def batch_iterate(size, items):',
        '    if size is None or size <= 0:',
        '        return [list(items)]',
        '    return chunk(items, size)',
        '',
        '',
        'async def abatch_iterate(size, items):',
        '    if size is None or size <= 0:',
        '        return [list(items)]',
        '    return chunk(items, size)',
      ),
      [],
    ],
    [
      'an async twin that maps its a-prefixed calls and awaits',
      code(
        'class Store:',
        '    def get(self, key):',
        '        value = self.load(key)',
        '        return self.decode(value)',
        '',
        '    async def aget(self, key):',
        '        value = await self.aload(key)',
        '        return self.decode(value)',
        '',
        '    def load(self, key):',
        '        return key',
        '',
        '    async def aload(self, key):',
        '        return key',
        '',
        '    def decode(self, value):',
        '        return value',
      ),
      [],
    ],
    [
      'an async twin that offloads the sync one to a thread',
      code(
        'import asyncio',
        '',
        '',
        'class Reader:',
        '    def read(self, path, encoding="utf-8"):',
        '        return open(path, encoding=encoding).read()',
        '',
        '    async def aread(self, path):',
        '        return await asyncio.to_thread(self.read, path)',
      ),
      [],
    ],
    [
      'a sync twin that runs the async one',
      code(
        'import asyncio',
        '',
        '',
        'async def afetch(url, retries=3):',
        '    return await download(url, retries)',
        '',
        '',
        'def fetch(url):',
        '    return asyncio.run(afetch(url))',
      ),
      [],
    ],
    [
      'an async twin that swaps the sleep and logs the same',
      code(
        'import asyncio',
        'import logging',
        'import time',
        '',
        'log = logging.getLogger(__name__)',
        '',
        '',
        'def poll(client):',
        '    log.info("polling")',
        '    time.sleep(1)',
        '    return client.status()',
        '',
        '',
        'async def apoll(client):',
        '    await asyncio.sleep(1)',
        '    return client.status()',
      ),
      [],
    ],
    [
      'a pair that is not twins because the sync function is a property',
      code(
        'class Box:',
        '    @property',
        '    def size(self):',
        '        return len(self.items)',
        '',
        '    async def asize(self, refresh):',
        '        return len(self.items)',
      ),
      [],
    ],
    [
      'two sync functions with an a-prefixed name',
      code(
        'def batch(size):',
        '    if size <= 0:',
        '        return []',
        '    return [size]',
        '',
        '',
        'def abatch(size):',
        '    return [size]',
      ),
      [],
    ],
    [
      'unrelated names that only differ by the a of await',
      code(
        'def wait_ready(client):',
        '    if not client:',
        '        return False',
        '    return client.ping()',
        '',
        '',
        'async def await_ready(client):',
        '    return client.ping()',
      ),
      [],
    ],
    [
      'a sync name shorter than three characters',
      code(
        'def go(x):',
        '    if not x:',
        '        return 0',
        '    return step(x)',
        '',
        '',
        'async def ago(x):',
        '    return step(x)',
      ),
      [],
    ],
    [
      'an async function without a sync twin',
      code('async def aload(path):', '    return await read(path)'),
      [],
    ],
    [
      'an async twin that shares no call with the sync one',
      code(
        'def total(items):',
        '    return sum(items)',
        '',
        '',
        'async def atotal(items, limit):',
        '    return await collect(items, limit)',
      ),
      [],
    ],
    [
      'twins in different classes',
      code(
        'class Sync:',
        '    def run(self, x, y):',
        '        return use(x, y)',
        '',
        '',
        'class Async:',
        '    async def arun(self, x):',
        '        return use(x)',
      ),
      [],
    ],
    [
      'cancellation handled by the async twin only',
      code(
        'import asyncio',
        '',
        '',
        'def work(job):',
        '    return job.run()',
        '',
        '',
        'async def awork(job):',
        '    try:',
        '        return await job.arun()',
        '    except asyncio.CancelledError:',
        '        raise',
      ),
      [],
    ],
  ]);
});
