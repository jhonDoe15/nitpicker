import { describe } from 'vitest';
import { useScripts, pythonLines as code } from '../../test-support/python-rule-scripts.mts';

const enabled = process.env['NITPICKER_PYTHON_E2E'] === '1';
const { itOutcomes } = useScripts({ enabled, hidden: ['test-without-assertion'] });

const VIEW = [
  'class Response:',
  '    pass',
  '',
  '',
  'class View:',
  '    def stage_ok(self) -> Response:',
  '        return Response()',
  '',
];
const RESULT = [
  'class Result:',
  '    pass',
  '',
  '',
  'def build() -> Result:',
  '    return Result()',
  '',
  '',
];

describe.skipIf(!enabled)('unreturned-result', () => {
  itOutcomes('flags a call that ends the function and has the type it returns', [
    [
      'a method as the last statement',
      code(...VIEW, '    def dispatch(self) -> Response:', '        self.stage_ok()'),
      ['unreturned-result:10 self.stage_ok()|Response'],
    ],
    [
      'a method as the last statement of a branch that ends the function',
      code(
        ...VIEW,
        '    def dispatch(self, request) -> Response:',
        '        if request.ok:',
        '            return Response()',
        '        else:',
        '            self.stage_ok()',
      ),
      ['unreturned-result:13 self.stage_ok()|Response'],
    ],
    [
      'a call in a branch that is followed by a bare return',
      code(
        ...VIEW,
        '    def dispatch(self, request) -> Response:',
        '        if request.ok:',
        '            return Response()',
        '        with request:',
        '            self.stage_ok()',
        '        return',
      ),
      ['unreturned-result:13 self.stage_ok()|Response'],
    ],
    [
      'the last statement of an if branch followed by another return',
      code(
        ...VIEW,
        '    def dispatch(self, request) -> Response:',
        '        if request.ok:',
        '            self.stage_ok()',
        '        elif request.late:',
        '            self.stage_ok()',
        '        return Response()',
      ),
      [
        'unreturned-result:11 self.stage_ok()|Response',
        'unreturned-result:13 self.stage_ok()|Response',
      ],
    ],
    [
      'a function without annotation whose other return has the type',
      code(
        ...VIEW,
        '    def dispatch(self, request):',
        '        if request.ok:',
        '            return self.stage_ok()',
        '        self.stage_ok()',
      ),
      ['unreturned-result:12 self.stage_ok()|Response'],
    ],
    [
      'a module function and an optional result',
      code(
        ...RESULT,
        'def handle(flag) -> Result | None:',
        '    if flag:',
        '        return None',
        '    build()',
      ),
      ['unreturned-result:12 build()|Result'],
    ],
    [
      'an awaited call in an async function',
      code(
        'class Result:',
        '    pass',
        '',
        '',
        'async def build() -> Result:',
        '    return Result()',
        '',
        '',
        'async def handle(flag) -> Result:',
        '    if flag:',
        '        return Result()',
        '    await build()',
      ),
      ['unreturned-result:12 build()|Result'],
    ],
    [
      'a helper imported from another module',
      {
        files: {
          'shop/flows.py': code(
            'class Flow:',
            '    pass',
            '',
            '',
            'def abort() -> Flow:',
            '    return Flow()',
          ),
          'shop/steps.py': code(
            'from .flows import Flow, abort',
            '',
            '',
            'def step(data) -> Flow:',
            '    if data:',
            '        return Flow()',
            '    abort()',
          ),
        },
      },
      ['unreturned-result:7 abort()|Flow'],
    ],
    [
      'a framework method that the project returns elsewhere with the same type',
      code(
        'from framework import ConfigFlow, FlowResult',
        '',
        '',
        'class Flow(ConfigFlow):',
        '    def first(self) -> FlowResult:',
        '        return self.async_update_and_abort()',
        '',
        '    def second(self, data) -> FlowResult:',
        '        if data:',
        '            return self.async_show_form()',
        '        self.async_update_and_abort()',
      ),
      ['unreturned-result:11 self.async_update_and_abort()|FlowResult'],
    ],
  ]);

  itOutcomes('stays quiet for returned results, other types and calls kept for their effect', [
    [
      'a returned or assigned result',
      code(
        ...VIEW,
        '    def dispatch(self, request) -> Response:',
        '        if request.ok:',
        '            return self.stage_ok()',
        '        response = self.stage_ok()',
        '        return response',
      ),
      [],
    ],
    [
      'a call in the middle of a branch and a call inside a loop branch',
      code(
        ...VIEW,
        '    def dispatch(self, request, items) -> Response:',
        '        if request.ok:',
        '            self.stage_ok()',
        '            request.done()',
        '        for item in items:',
        '            if item:',
        '                self.stage_ok()',
        '        return Response()',
      ),
      [],
    ],
    [
      'a warm-up call before a return',
      code(...RESULT, 'def handle() -> Result:', '    build()', '    return Result()'),
      [],
    ],
    [
      'a helper that returns its own argument',
      code(
        'class User:',
        '    pass',
        '',
        '',
        'def normalize(user: User) -> User:',
        '    user.name = "x"',
        '    return user',
        '',
        '',
        'def save(user: User) -> User:',
        '    normalize(user)',
      ),
      [],
    ],
    [
      'a call whose argument the function returns on another path',
      code(
        'class User:',
        '    pass',
        '',
        '',
        'def fresh(user: User) -> User:',
        '    return User()',
        '',
        '',
        'def save(user: User, flag) -> User:',
        '    if flag:',
        '        return user',
        '    fresh(user)',
      ),
      [],
    ],
    [
      'a builder method that returns self',
      code(
        'class Builder:',
        '    def part(self) -> "Builder":',
        '        return self',
        '',
        '    def build(self) -> "Builder":',
        '        self.part()',
        '        return self',
      ),
      [],
    ],
    [
      'results of builtin types',
      code(
        'def count() -> int:',
        '    return 1',
        '',
        '',
        'def names() -> list[str]:',
        '    return []',
        '',
        '',
        'def run() -> int:',
        '    count()',
        '    names()',
      ),
      [],
    ],
    [
      'a call of another result type',
      code(
        'class A:',
        '    pass',
        '',
        '',
        'class B:',
        '    pass',
        '',
        '',
        'def make_a() -> A:',
        '    return A()',
        '',
        '',
        'def make_b() -> B:',
        '    make_a()',
      ),
      [],
    ],
    [
      'a function that returns nothing',
      code(
        ...VIEW,
        '    def run(self):',
        '        self.stage_ok()',
        '',
        '    def other(self) -> None:',
        '        self.stage_ok()',
      ),
      [],
    ],
    [
      'a method of an unknown object',
      code(...VIEW, '    def dispatch(self, other) -> Response:', '        other.stage_ok()'),
      [],
    ],
    [
      'a call at the end of a loop',
      code(
        ...VIEW,
        '    def dispatch(self, items) -> Response:',
        '        for item in items:',
        '            self.stage_ok()',
      ),
      [],
    ],
    [
      'a generator',
      code(
        ...VIEW,
        '    def stream(self) -> Response:',
        '        yield 1',
        '        self.stage_ok()',
      ),
      [],
    ],
    [
      'a decorated callee',
      code(
        'import functools',
        '',
        '',
        'class Response:',
        '    pass',
        '',
        '',
        'class View:',
        '    @functools.cache',
        '    def warm(self) -> Response:',
        '        return Response()',
        '',
        '    def dispatch(self) -> Response:',
        '        self.warm()',
      ),
      [],
    ],
    [
      'framework evidence that disagrees',
      code(
        'from framework import ConfigFlow, FlowResult, Other',
        '',
        '',
        'class Flow(ConfigFlow):',
        '    def first(self) -> FlowResult:',
        '        return self.finish()',
        '',
        '    def second(self) -> Other:',
        '        return self.finish()',
        '',
        '    def third(self) -> FlowResult:',
        '        self.finish()',
      ),
      [],
    ],
    [
      'a self method on a class whose bases are all in the project',
      code(
        'class Base:',
        '    pass',
        '',
        '',
        'class Child(Base):',
        '    def run(self) -> Base:',
        '        self.finish()',
      ),
      [],
    ],
  ]);

  itOutcomes('skips test files', [
    [
      'a dropped result in a test helper',
      {
        file: 'tests/helpers.py',
        code: code(
          'class R:',
          '    pass',
          '',
          '',
          'def make() -> R:',
          '    return R()',
          '',
          '',
          'def run() -> R:',
          '    make()',
        ),
      },
      [],
    ],
  ]);
});
