import { describe, expect, it } from 'vitest';
import { dropGeneratedFindings } from './generated-files.mts';
import { useGitFixtures } from '../../../core/diff/git/test-support/git-repository.mts';
import { writeFiles } from '../../../core/diff/git/test-support/fixture-files.mts';

const { temporaryRoot } = useGitFixtures();

function project(files: Record<string, string>): string {
  const root = temporaryRoot('generated-files-');
  writeFiles(root, files);
  return root;
}

const finding = (rule: string, file: string) => ({
  rule,
  path: file,
  subject: 'Cart.total',
  line: 5,
});

describe('dropGeneratedFindings', () => {
  it('drops only the named rules in generated files', () => {
    const root = project({
      'src/cart.py': 'class Cart:\n    pass\n',
      'src/orders_pb2.py': 'class Orders:\n    pass\n',
      'src/models.py':
        '# Generated by the protocol buffer compiler.  DO NOT EDIT!\nclass M:\n    pass\n',
    });
    const findings = [
      finding('forwarding-method-alias', 'src/cart.py'),
      finding('forwarding-method-alias', 'src/orders_pb2.py'),
      finding('forwarding-method-alias', 'src/models.py'),
      finding('other-rule', 'src/orders_pb2.py'),
    ];

    expect(dropGeneratedFindings(findings, root, ['forwarding-method-alias'])).toEqual([
      finding('forwarding-method-alias', 'src/cart.py'),
      finding('other-rule', 'src/orders_pb2.py'),
    ]);
  });
});
