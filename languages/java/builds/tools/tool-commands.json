{
  "cpd": {
    "args": [
      "cpd",
      "--minimum-tokens",
      "100",
      "--ignore-identifiers",
      "--ignore-literals",
      "--language",
      "java",
      "--format",
      "xml",
      "--no-fail-on-error",
      { "each": "directories", "flag": "--dir" }
    ],
    "accept": { "exits": [0, 4] }
  },
  "forbiddenapis": {
    "args": [
      { "each": "classDirectories", "flag": "-d" },
      "-c",
      { "join": "libraries", "separator": "path" },
      "-f",
      { "value": "signatures" },
      "--allowmissingclasses"
    ],
    "accept": { "exits": [0, 1] }
  },
  "pmd": {
    "args": [
      "check",
      "--no-cache",
      "--no-progress",
      "--format",
      "sarif",
      "--report-file",
      { "value": "report" },
      "--rulesets",
      { "join": "rulesets", "separator": "," },
      "--aux-classpath",
      { "value": "auxClasspath", "prefix": "file:" },
      "--suppress-marker",
      "NITPICKER-NO-INLINE-SUPPRESSION",
      "--dir",
      { "join": "directories", "separator": "," }
    ],
    "accept": { "report": "report" }
  },
  "jdeps": {
    "args": ["-verbose:class", "-filter:none", { "each": "classDirectories" }],
    "accept": { "exits": [0] }
  }
}
