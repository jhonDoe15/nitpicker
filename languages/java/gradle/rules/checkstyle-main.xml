<?xml version="1.0"?>
<modules>
    <module name="MagicNumber">
      <property name="ignoreHashCodeMethod" value="true"/>
      <property name="ignoreAnnotation" value="true"/>
      <message key="magic.number" value="''{0}'' is a magic number. Name it as a private static final constant. If it is right here, add an exception for checkstyle/com.puppycrawl.tools.checkstyle.checks.coding.MagicNumberCheck in nitpicker.config.json."/>
    </module>
    <module name="VisibilityModifier">
      <property name="allowPublicFinalFields" value="true"/>
      <message key="variable.notPrivate" value="Variable ''{0}'' must be private, with an accessor if callers need it. Use a record for plain data. If it is right here, add an exception for checkstyle/com.puppycrawl.tools.checkstyle.checks.design.VisibilityModifierCheck in nitpicker.config.json."/>
    </module>
    <module name="SuppressionXpathSingleFilter">
      <property name="checks" value="VisibilityModifierCheck"/>
      <property name="query" value="//CLASS_DEF[./MODIFIERS/ANNOTATION/IDENT[@text = 'MappedSuperclass']]/OBJBLOCK/VARIABLE_DEF[./MODIFIERS/LITERAL_PROTECTED]/IDENT"/>
    </module>
    <module name="SuppressionXpathSingleFilter">
      <property name="checks" value="VisibilityModifierCheck"/>
      <property name="query" value="//CLASS_DEF[./MODIFIERS/ANNOTATION[(./IDENT | ./DOT/IDENT)[@text = 'Value'] or (./IDENT | ./DOT/IDENT)[@text = 'FieldDefaults'] and .//IDENT[@text = 'PRIVATE']]]/OBJBLOCK/VARIABLE_DEF[not(./MODIFIERS/LITERAL_PUBLIC or ./MODIFIERS/LITERAL_PROTECTED or ./MODIFIERS/LITERAL_STATIC)]/IDENT"/>
    </module>
</modules>
