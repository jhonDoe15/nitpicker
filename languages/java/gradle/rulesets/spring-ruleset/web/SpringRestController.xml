    <properties><property name="xpath"><value><![CDATA[
//ClassDeclaration[ModifierList/Annotation[pmd-java:typeIs('org.springframework.web.bind.annotation.RestController')]]
  //Annotation[pmd-java:typeIs('org.springframework.web.bind.annotation.ResponseBody')]
|
//ClassDeclaration[ModifierList/Annotation[pmd-java:typeIs('org.springframework.stereotype.Controller')]]
  /ModifierList/Annotation[pmd-java:typeIs('org.springframework.web.bind.annotation.ResponseBody')]
]]></value></property></properties>
  </rule>
