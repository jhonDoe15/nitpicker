  <rule name="SpringPasswordEncoder" language="java" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule"
        message="Hash passwords with PasswordEncoderFactories.createDelegatingPasswordEncoder(). NoOpPasswordEncoder stores them in plain text, and the MD4, message-digest, LDAP SHA and standard SHA-256 encoders and User.withDefaultPasswordEncoder() are not safe for passwords.">
    <priority>1</priority>
    <properties><property name="xpath"><value><![CDATA[
//ClassType[
    pmd-java:typeIs('org.springframework.security.crypto.password.NoOpPasswordEncoder')
    or pmd-java:typeIs('org.springframework.security.crypto.password.MessageDigestPasswordEncoder')
    or pmd-java:typeIs('org.springframework.security.crypto.password.Md4PasswordEncoder')
    or pmd-java:typeIs('org.springframework.security.crypto.password.LdapShaPasswordEncoder')
    or pmd-java:typeIs('org.springframework.security.crypto.password.StandardPasswordEncoder')]
  [not(ancestor::ImportDeclaration)]
|
//MethodCall[pmd-java:matchesSig('org.springframework.security.crypto.password.NoOpPasswordEncoder#getInstance()')]
  [not(*[1][self::TypeExpression])]
|
//MethodCall[@MethodName = 'withDefaultPasswordEncoder']
  [*[1][self::TypeExpression and pmd-java:typeIs('org.springframework.security.core.userdetails.User')]]
]]></value></property></properties>
  </rule>
