  <rule name="RetryInTest" language="java" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule"
        message="Remove the retry: a test that passes on a later attempt hides a flaky or racy test. Fix the cause, such as waiting on the condition instead of a fixed delay or isolating shared state.">
    <priority>2</priority>
    <properties>
      <property name="xpath">
        <value><![CDATA[
//Annotation[pmd-java:typeIs('org.junitpioneer.jupiter.RetryingTest')
             or pmd-java:typeIs('io.github.artsok.RepeatedIfExceptionsTest')]
| //Annotation[pmd-java:typeIs('org.testng.annotations.Test')]//MemberValuePair[@Name = 'retryAnalyzer']
| //(ClassDeclaration | EnumDeclaration | RecordDeclaration)/(ExtendsList | ImplementsList)/ClassType
    [pmd-java:typeIs('org.testng.IRetryAnalyzer')]
| //ConstructorCall[AnonymousClassDeclaration][pmd-java:typeIs('org.testng.IRetryAnalyzer')]
| //(LambdaExpression | MethodReference)[pmd-java:typeIs('org.testng.IRetryAnalyzer')]
| //MethodCall[pmd-java:matchesSig('org.testng.annotations.ITestAnnotation#setRetryAnalyzer(_)')]
]]></value>
      </property>
    </properties>
  </rule>
