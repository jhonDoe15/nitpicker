<?xml version="1.0" encoding="UTF-8"?>
<!-- Nitpicker's PMD rules for main sources only: API design rules and the class-load effect rule
     that, like their TypeScript counterparts, leave test code alone, the inline resource rule, and
     the security category, since a test encrypts with a fixed key and IV to check known output.
     Gradle and Maven reference this file from a generated ruleset that excludes the test source
     roots. docs/java-preset.md lists the rules and why each exists. -->
<ruleset name="nitpicker-main-rules"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
  <description>Nitpicker's PMD rules for main sources.</description>
  <rule ref="category/java/security.xml"/>
