<?xml version="1.0" encoding="UTF-8"?>
<!-- Bug patterns that Error Prone (main and test code) or PMD already report on the same code, so
     each issue is reported once. Used by the java preset only: in the kotlin preset SpotBugs also
     reads Kotlin classes, which Error Prone does not compile. docs/java-preset.md, "Overlaps with
     PMD and SpotBugs", names the check that covers each one. -->
<FindBugsFilter>
  <Match><Bug pattern="BC_EQUALS_METHOD_SHOULD_WORK_FOR_ALL_OBJECTS"/></Match>
  <Match><Bug pattern="DC_DOUBLECHECK"/></Match>
  <Match><Bug pattern="DM_DEFAULT_ENCODING"/></Match>
  <Match><Bug pattern="DMI_COLLECTION_OF_URLS"/></Match>
  <Match><Bug pattern="DMI_INVOKING_HASHCODE_ON_ARRAY"/></Match>
  <Match><Bug pattern="DMI_INVOKING_TOSTRING_ON_ARRAY"/></Match>
  <Match><Bug pattern="EC_BAD_ARRAY_COMPARE"/></Match>
  <Match><Bug pattern="EC_UNRELATED_TYPES"/></Match>
  <Match><Bug pattern="EQ_SELF_NO_OBJECT"/></Match>
  <Match><Bug pattern="EQ_SELF_USE_OBJECT"/></Match>
  <Match><Bug pattern="GC_UNRELATED_TYPES"/></Match>
  <Match><Bug pattern="HE_EQUALS_NO_HASHCODE"/></Match>
  <Match><Bug pattern="HE_EQUALS_USE_HASHCODE"/></Match>
  <Match><Bug pattern="HE_HASHCODE_NO_EQUALS"/></Match>
  <Match><Bug pattern="HE_HASHCODE_USE_OBJECT_EQUALS"/></Match>
  <Match><Bug pattern="ICAST_BAD_SHIFT_AMOUNT"/></Match>
  <Match><Bug pattern="ICAST_IDIV_CAST_TO_DOUBLE"/></Match>
  <Match><Bug pattern="ICAST_INTEGER_MULTIPLY_CAST_TO_LONG"/></Match>
  <Match><Bug pattern="IL_INFINITE_RECURSIVE_LOOP"/></Match>
  <Match><Bug pattern="INT_BAD_COMPARISON_WITH_SIGNED_BYTE"/></Match>
  <Match><Bug pattern="ML_SYNC_ON_FIELD_TO_GUARD_CHANGING_THAT_FIELD"/></Match>
  <Match><Bug pattern="MS_FINAL_PKGPROTECT"/></Match>
  <Match><Bug pattern="MS_SHOULD_BE_FINAL"/></Match>
  <Match><Bug pattern="NP_EQUALS_SHOULD_HANDLE_NULL_ARGUMENT"/></Match>
  <Match><Bug pattern="NP_TOSTRING_COULD_RETURN_NULL"/></Match>
  <Match><Bug pattern="RE_BAD_SYNTAX_FOR_REGULAR_EXPRESSION"/></Match>
  <Match><Bug pattern="RE_POSSIBLE_UNINTENDED_PATTERN"/></Match>
  <Match><Bug pattern="RV_01_TO_INT"/></Match>
  <Match><Bug pattern="RV_ABSOLUTE_VALUE_OF_RANDOM_INT"/></Match>
  <Match><Bug pattern="RV_EXCEPTION_NOT_THROWN"/></Match>
  <Match><Bug pattern="RV_RETURN_VALUE_IGNORED"/></Match>
  <Match><Bug pattern="SA_FIELD_SELF_ASSIGNMENT"/></Match>
  <Match><Bug pattern="SA_LOCAL_SELF_ASSIGNMENT"/></Match>
  <Match><Bug pattern="SR_NOT_CHECKED"/></Match>
  <Match><Bug pattern="SS_SHOULD_BE_STATIC"/></Match>
  <Match><Bug pattern="UCF_USELESS_CONTROL_FLOW_NEXT_LINE"/></Match>
  <Match><Bug pattern="UL_UNRELEASED_LOCK"/></Match>
  <Match><Bug pattern="UL_UNRELEASED_LOCK_EXCEPTION_PATH"/></Match>
  <Match><Bug pattern="UW_UNCOND_WAIT"/></Match>
  <Match><Bug pattern="VO_VOLATILE_INCREMENT"/></Match>
  <Match><Bug pattern="WA_NOT_IN_LOOP"/></Match>
</FindBugsFilter>
