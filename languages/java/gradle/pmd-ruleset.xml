<?xml version="1.0" encoding="UTF-8"?>
<!-- Nitpicker's PMD rules: the errorprone, bestpractices, performance and multithreading categories
     plus a catch rule from design, run over main and test sources (the security category runs on
     main sources only, from pmd-main-ruleset.xml). Two test rules are left out because they set an
     assertion style the TypeScript preset does not have: a message on every assertion, and one
     assertion per test. A test without any assertion still fails (UnitTestShouldIncludeAssert),
     and mutation testing catches weak ones. Rules that report the same code as Error Prone,
     SpotBugs or Checkstyle stay on: a rule whose finding repeats another tool's on the same code is
     dropped after policy only while that other finding is reported
     (languages/java/adapters/overlaps/overlap-pairs.json, docs/java-preset.md "Overlaps"). -->
<ruleset name="nitpicker"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
  <description>Nitpicker's PMD categories for main and test sources.</description>
  <rule ref="category/java/errorprone.xml">
    <exclude name="TestClassWithoutTestCases"/>
    <exclude name="AvoidFieldNameMatchingMethodName"/>
    <exclude name="AvoidLiteralsInIfCondition"/>
    <exclude name="AssignmentInOperand"/>
  </rule>
  <rule ref="category/java/errorprone.xml/AvoidFieldNameMatchingMethodName"
        message="Field {0} has the same name as a method. Rename one of them; a method named exactly like its field with at most one parameter (an accessor, a fluent setter or builder step) is allowed.">
    <properties>
      <property name="xpath">
        <value><![CDATA[
//FieldDeclaration[not(pmd-java:modifiers() = 'static' and pmd-java:modifiers() = 'final')]/VariableDeclarator/VariableId
    [some $method in ../../..[self::ClassBody or self::EnumBody]/MethodDeclaration
     satisfies lower-case(@Name) = lower-case($method/@Name)
       and not(@Name = $method/@Name and $method/FormalParameters[@Size < 2])]
]]></value>
      </property>
    </properties>
  </rule>
  <rule ref="category/java/errorprone.xml/AvoidLiteralsInIfCondition"
        message="Use a named constant instead of this literal in the condition (-1, 0, 1 and 2 are allowed).">
    <properties>
      <property name="ignoreMagicNumbers" value="-1,0,1,2"/>
      <property name="violationSuppressXPath" value=".[self::StringLiteral or self::CharLiteral]"/>
    </properties>
  </rule>
  <rule ref="category/java/errorprone.xml/AssignmentInOperand"
        message="Assign first, then use the variable. An assignment in a while condition is allowed.">
    <properties>
      <property name="allowWhile" value="true"/>
    </properties>
  </rule>
  <rule ref="category/java/bestpractices.xml">
    <exclude name="AbstractClassWithoutAbstractMethod"/>
    <exclude name="GuardLogStatement"/>
    <exclude name="UnitTestAssertionsShouldIncludeMessage"/>
    <exclude name="UnitTestContainsTooManyAsserts"/>
    <exclude name="UnitTestShouldIncludeAssert"/>
  </rule>
  <rule ref="category/java/bestpractices.xml/AbstractClassWithoutAbstractMethod">
    <properties>
      <property name="violationSuppressXPath"
                value="./ModifierList/Annotation[pmd-java:typeIs('jakarta.persistence.MappedSuperclass') or pmd-java:typeIs('javax.persistence.MappedSuperclass')]"/>
    </properties>
  </rule>
  <rule ref="category/java/bestpractices.xml/UnitTestShouldIncludeAssert">
    <properties>
      <property name="extraAssertMethodNames"
                value="andExpect,andExpectAll,should,shouldHaveNoInteractions,shouldHaveNoMoreInteractions,expectStatus,expectBody,expectHeader,expectNext,expectNextCount,expectComplete,expectError,verifyComplete,verifyError,verifyTimeout"/>
    </properties>
  </rule>
  <rule ref="category/java/bestpractices.xml/GuardLogStatement"
        message="Pass values as placeholders (LOG.debug(&quot;user '{'}&quot;, user)) and compute nothing in the arguments; guard the call with isDebugEnabled() only when an argument must be computed.">
    <properties>
      <property name="logLevels" value="trace,debug,finest,finer,fine"/>
      <property name="guardsMethods" value="isTraceEnabled,isDebugEnabled,isLoggable"/>
      <property name="violationSuppressXPath">
        <value><![CDATA[
./MethodCall[ArgumentList/*[1][self::StringLiteral]]
  [not(ArgumentList/*[position() > 1][not(
     self::VariableAccess or self::FieldAccess or self::ThisExpression or self::StringLiteral
     or self::NumericLiteral or self::BooleanLiteral or self::CharLiteral or self::NullLiteral
     or (self::MethodCall[ArgumentList[@Size = 0]]
         [*[1][self::VariableAccess or self::FieldAccess or self::ThisExpression]]))])]
]]></value>
      </property>
    </properties>
  </rule>
  <rule name="LogStringConcatenation" language="java" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule"
        message="Pass values as placeholders (LOG.info(&quot;user '{'}&quot;, user); '{'0} in System.Logger and java.util.logging), not a message built with + or String.format.">
    <priority>3</priority>
    <properties>
      <property name="xpath">
        <value><![CDATA[
//MethodCall[@MethodName = ('info', 'warn', 'error', 'log', 'config', 'warning', 'severe')]
  [*[1][pmd-java:typeIs('org.slf4j.Logger') or pmd-java:typeIs('org.slf4j.spi.LoggingEventBuilder')
    or pmd-java:typeIs('java.util.logging.Logger') or pmd-java:typeIs('java.lang.System.Logger')
    or pmd-java:typeIs('org.apache.logging.log4j.Logger') or pmd-java:typeIs('org.apache.commons.logging.Log')]]
  /ArgumentList/(*[1] | *[1][not(pmd-java:typeIs('java.lang.String'))]/following-sibling::*[1])
  [(self::InfixExpression[@Operator = '+'] and not(@CompileTimeConstant = true()))
    or self::MethodCall[@MethodName = ('format', 'formatted')]]
]]></value>
      </property>
    </properties>
  </rule>
  <rule name="GeneratedOnHandWrittenCode" language="java" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule"
        message="JaCoCo and PIT skip code annotated @Generated, so this is not measured. Remove the annotation from hand-written code.">
    <priority>2</priority>
    <properties>
      <property name="xpath">
        <value><![CDATA[
//(ClassDeclaration | RecordDeclaration | EnumDeclaration | MethodDeclaration | ConstructorDeclaration | CompactConstructorDeclaration)
  /ModifierList/Annotation[@SimpleName = 'Generated']
]]></value>
      </property>
    </properties>
  </rule>
  <rule ref="category/java/performance.xml">
    <exclude name="AvoidArrayLoops"/>
    <exclude name="AvoidFileStream"/>
    <exclude name="UseArraysAsList"/>
    <!-- A loop that needs a distinct object per item is correct; hoisting changes it. -->
    <exclude name="AvoidInstantiatingObjectsInLoops"/>
    <!-- A small exhaustive switch is valid. -->
    <exclude name="TooFewBranchesForSwitch"/>
    <!-- A capacity hint is a micro-optimization; asking for one only adds magic numbers. -->
    <exclude name="InsufficientStringBufferDeclaration"/>
  </rule>
  <rule ref="category/java/multithreading.xml">
    <exclude name="DontCallThreadRun"/>
    <!-- volatile is a valid visibility primitive. -->
    <exclude name="AvoidUsingVolatile"/>
    <!-- The J2EE container restriction does not apply to most applications. -->
    <exclude name="DoNotUseThreads"/>
    <!-- A Map declaration does not show concurrent access. -->
    <exclude name="UseConcurrentHashMap"/>
  </rule>
  <rule ref="category/java/performance.xml/AvoidArrayLoops">
    <properties>
      <!-- A loop that subtracts the loop variable in an index (a reversed copy) has no
           System.arraycopy form. -->
      <property name="violationSuppressXPath">
        <value><![CDATA[
.//AssignmentExpression/ArrayAccess/*[2]/descendant-or-self::InfixExpression[@Operator = '-']
  /*[2]/descendant-or-self::VariableAccess[not(parent::FieldAccess)]
]]></value>
      </property>
    </properties>
  </rule>
  <rule ref="category/java/performance.xml/AvoidFileStream">
    <properties>
      <!-- Files has no form that wraps a FileDescriptor such as FileDescriptor.in. -->
      <property name="violationSuppressXPath"
                value="..[ArgumentList/*[1][pmd-java:typeIs('java.io.FileDescriptor')]]"/>
    </properties>
  </rule>
  <rule ref="category/java/performance.xml/UseArraysAsList">
    <properties>
      <!-- Only a loop that adds every element and does nothing else is a copy: a loop that
           filters, or steps by more than one, stays. -->
      <property name="violationSuppressXPath">
        <value><![CDATA[
.[count(../../*) > 1
  or ../../..[self::ForStatement][not(ForUpdate/StatementExpressionList/UnaryExpression[@Operator = '++'])]]
]]></value>
      </property>
    </properties>
  </rule>
  <rule ref="category/java/multithreading.xml/DontCallThreadRun">
    <properties>
      <!-- super.run() in a Thread subclass's run() runs the parent body on the same thread. -->
      <property name="violationSuppressXPath" value=".[*[1][self::SuperExpression]]"/>
    </properties>
  </rule>
  <rule ref="category/java/design.xml/AvoidCatchingGenericException"/>
</ruleset>
