<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>modes</groupId><artifactId>guards-compile-modes</artifactId><version>1.0</version></parent>
  <artifactId>plugged</artifactId>
  <dependencies>
    <dependency><groupId>modes</groupId><artifactId>plugin</artifactId><version>1.0</version><scope>provided</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration><compilerArgs><arg>-Xplugin:Noop</arg></compilerArgs></configuration>
      </plugin>
    </plugins>
  </build>
</project>
