import { readFileSync } from 'node:fs';
import path from 'node:path';
import { parse } from 'yaml';
import { type Fields, fieldAt, fieldsOf, listOf } from '../json/fields.mts';
import { type ExpectedDifference, EXPECTED_DIFFERENCES } from './compare-runs.mts';
import { containedPath } from '../../core/fix/common/contained-path.mjs';

const ROOT = path.resolve(import.meta.dirname, '../..');
const START = '<!-- support-matrix:start (generated by npm run gen:checks; do not edit) -->';
const END = '<!-- support-matrix:end -->';
const OS_NAMES: Readonly<Record<string, string>> = {
  'ubuntu-latest': 'Linux',
  'macos-latest': 'macOS',
  'windows-latest': 'Windows',
};
const PLATFORM_NAMES: Readonly<Record<string, string>> = {
  linux: 'Linux',
  darwin: 'macOS',
  win32: 'Windows',
};
const RUNTIME_NAMES: Readonly<Record<string, string>> = { deno: 'Deno' };
const PACKAGE_MANAGER_FIXTURES =
  'languages/typescript/adapters/dependency-graph/package-managers/fixtures/projects';

type Sources = {
  readonly node: string;
  readonly engines: string;
  readonly sampleSystems: readonly string[];
  readonly deno: string;
  readonly jdk: string;
  readonly sampleJdk: string;
  readonly bun: string;
  readonly pnpm: string;
  readonly yarn: string;
  readonly berry: string;
  readonly gradle: string;
  readonly kotlinGradle: string;
  readonly sampleGradle: string;
  readonly python: string;
  readonly samplePython: string;
  readonly poetry: string;
  readonly development: Fields;
  readonly junit: string;
  readonly kotlinPlugin: string;
};

function text(file: string): string {
  return readFileSync(containedPath(ROOT, file), 'utf8');
}

function workflow(name: string): unknown {
  return parse(text(`.github/workflows/${name}.yml`));
}

function stepsOf(job: unknown): Fields[] {
  return listOf(fieldAt(job, 'steps')).map((candidate) => fieldsOf(candidate) ?? {});
}

function step(job: unknown, action: string): Fields {
  const found = stepsOf(job).find(
    ({ uses }) => typeof uses === 'string' && uses.startsWith(`${action}@`),
  );
  if (found === undefined) {
    throw new Error(`No ${action} step in a workflow job the matrix reads`);
  }
  return fieldsOf(found['with']) ?? {};
}

function setting(job: unknown, action: string, key: string): string {
  return String(step(job, action)[key]);
}

function runVersion(job: unknown, pattern: RegExp): string {
  const command = stepsOf(job)
    .map(({ run }) => (typeof run === 'string' ? run : ''))
    .find((run) => pattern.test(run));
  return pattern.exec(command ?? '')?.[1] ?? 'not pinned';
}

function pinned(file: string, name: string): string {
  const line = text(file)
    .split('\n')
    .find((candidate) => candidate.startsWith(`${name}==`));
  return line?.split('==')[1]?.trim() ?? 'not pinned';
}

function buildPin(file: string, pattern: RegExp): string {
  return pattern.exec(text(file))?.[1] ?? 'not pinned';
}

function readJson(file: string): unknown {
  return JSON.parse(text(file));
}

function packageManagerPin(fixture: string): string {
  const manifest = readJson(`${PACKAGE_MANAGER_FIXTURES}/${fixture}/package.json`);
  return String(fieldAt(manifest, 'packageManager')).split('@')[1] ?? 'not pinned';
}

function versions(value: unknown): string {
  return String(value).trim().split(/\s+/u).join(', ');
}

function readSources(): Sources {
  const typescript = workflow('typescript');
  const java = fieldAt(workflow('java-e2e'), 'jobs', 'java-shard');
  const kotlin = fieldAt(workflow('kotlin-e2e'), 'jobs', 'kotlin-shard');
  const python = fieldAt(workflow('python-e2e'), 'jobs', 'python-shard');
  const platforms = workflow('platforms');
  const testShard = fieldAt(typescript, 'jobs', 'test-shard');
  const manifest = readJson('package.json');
  const samples = fieldAt(platforms, 'jobs', 'samples');
  const runtimes = fieldAt(platforms, 'jobs', 'runtimes');
  return {
    node: setting(testShard, 'actions/setup-node', 'node-version'),
    engines: String(fieldAt(manifest, 'engines', 'node')),
    sampleSystems: listOf(fieldAt(samples, 'strategy', 'matrix', 'os')).map(
      (os) => OS_NAMES[String(os)] ?? String(os),
    ),
    deno: setting(runtimes, 'denoland/setup-deno', 'deno-version'),
    jdk: setting(java, 'actions/setup-java', 'java-version'),
    sampleJdk: setting(samples, 'actions/setup-java', 'java-version'),
    bun: setting(testShard, 'oven-sh/setup-bun', 'bun-version'),
    pnpm: packageManagerPin('pnpm'),
    yarn: packageManagerPin('yarn'),
    berry: packageManagerPin('berry'),
    gradle: setting(java, 'gradle/actions/setup-gradle', 'gradle-version'),
    kotlinGradle: setting(kotlin, 'gradle/actions/setup-gradle', 'gradle-version'),
    sampleGradle: setting(samples, 'gradle/actions/setup-gradle', 'gradle-version'),
    python: versions(step(python, 'actions/setup-python')['python-version']),
    samplePython: versions(step(samples, 'actions/setup-python')['python-version']),
    poetry: runVersion(python, /poetry==(\S+)/u),
    development: fieldsOf(fieldAt(manifest, 'devDependencies')) ?? {},
    junit: buildPin(
      'languages/java/adapters/fixtures/gradle-project/build.gradle',
      /junit-jupiter:([\d.]+)/u,
    ),
    kotlinPlugin: buildPin(
      'languages/java/adapters/fixtures/kotlin-project/build.gradle.kts',
      /kotlin\("jvm"\) version "([^"]+)"/u,
    ),
  };
}

function constraint(name: string): string {
  return pinned('.github/python-e2e-constraints.txt', name);
}

function systemsCell(sources: Sources, sampled: boolean): string {
  const smoke = sources.sampleSystems.filter((name) => name !== 'Linux');
  return sampled ? `Linux (full suite); ${smoke.join(', ')} (sample run)` : 'Linux (full suite)';
}

function presetRows(sources: Sources): string[][] {
  const node = `Node.js ${sources.node} (needs ${sources.engines})`;
  const { vitest: vitestVersion, jest, mocha } = sources.development;
  const vitest = `Vitest ${String(vitestVersion)}, Jest ${String(jest)}, Mocha ${String(mocha)}, \`node:test\``;
  const jdk = `JDK ${sources.jdk} (Temurin)`;
  const sampledJdk = `JDK ${sources.jdk} (Temurin; samples: ${sources.sampleJdk})`;
  const yarn = `Yarn ${sources.yarn} and ${sources.berry}`;
  const managers = `npm; pnpm ${sources.pnpm}, ${yarn}, Bun ${sources.bun} for base installs`;
  return [
    [
      'TypeScript',
      systemsCell(sources, true),
      `${node}; Deno ${sources.deno} (sample run)`,
      managers,
      vitest,
    ],
    ['JavaScript', systemsCell(sources, false), node, managers, vitest],
    [
      'Java',
      systemsCell(sources, true),
      `${node}; ${sampledJdk}`,
      `Gradle ${sources.gradle}; Maven from the runner image`,
      `JUnit ${sources.junit}`,
    ],
    [
      'Kotlin',
      systemsCell(sources, false),
      `${node}; ${jdk}; Kotlin ${sources.kotlinPlugin}`,
      `Gradle ${sources.kotlinGradle}`,
      `JUnit 5 through \`kotlin("test")\``,
    ],
    [
      'Python',
      systemsCell(sources, true),
      `${node}; Python ${sources.python} (samples: ${sources.samplePython})`,
      `uv ${constraint('uv')}, Poetry ${sources.poetry}`,
      [
        `pytest ${constraint('pytest')}, nose2 ${constraint('nose2')}, \`unittest\``,
        `coverage ${constraint('coverage')}, mutmut ${constraint('mutmut')}`,
      ].join('; '),
    ],
  ];
}

function tableRow(cells: readonly string[], widths: readonly number[]): string {
  return `| ${cells.map((cell, index) => cell.padEnd(widths[index] ?? 0)).join(' | ')} |`;
}

function table(header: readonly string[], rows: readonly (readonly string[])[]): string {
  const widths = header.map((title, column) =>
    Math.max(title.length, ...rows.map((row) => (row[column] ?? '').length)),
  );
  const separator = `| ${widths.map((width) => '-'.repeat(width)).join(' | ')} |`;
  return [tableRow(header, widths), separator, ...rows.map((row) => tableRow(row, widths))].join(
    '\n',
  );
}

function where({ runtime, platform }: ExpectedDifference): string {
  return [
    platform === undefined ? undefined : PLATFORM_NAMES[platform],
    runtime === undefined ? undefined : RUNTIME_NAMES[runtime],
  ]
    .filter(Boolean)
    .join(', ');
}

function analyzerCell({ analyzer, findingTools = [] }: ExpectedDifference): string {
  return [analyzer, ...findingTools].map((tool) => `\`${tool}\``).join(', ');
}

export function renderSupportMatrix(sources: Sources = readSources()): string {
  const limits = EXPECTED_DIFFERENCES.map((expected) => [
    where(expected),
    expected.sample,
    analyzerCell(expected),
    expected.reason,
  ]);
  return [
    table(
      ['Preset', 'Operating systems', 'Runtimes', 'Build tools', 'Test runners'],
      presetRows(sources),
    ),
    '',
    `The sample runs check these differences from the Linux run under Node.js ${sources.node}; ` +
      'every other finding must match:',
    '',
    table(['Where', 'Sample', 'Analyzers', 'Why'], limits),
  ].join('\n');
}

export function applySupportMatrix(document: string): string {
  const start = document.indexOf(START);
  const end = document.indexOf(END);
  if (start === -1 || end < start) {
    throw new Error(`docs/compatibility.md must contain the markers ${START} and ${END}`);
  }
  return `${document.slice(0, start + START.length)}\n\n${renderSupportMatrix()}\n\n${document.slice(end)}`;
}
